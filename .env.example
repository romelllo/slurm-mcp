# ── slurm-mcp — per-user settings ──────────────────────────────────────────────
# Copy to .env and fill in.  .env is gitignored — it contains credentials.

# ── SSH connection to the cluster login node ───────────────────────────────────
HPC_HOST=login.cluster.example.org
HPC_USER=your_username
HPC_PORT=22

# Private key on THIS machine. With Docker it is mounted read-only into the container.
HPC_KEY_PATH=~/.ssh/id_ed25519
# Only if the key is protected by a passphrase.
HPC_KEY_PASSPHRASE=
# Only if the server still asks for a password / keyboard-interactive prompt after the key
# is accepted ("Partial success" in `ssh -v` output). Leave empty for key-only auth.
HPC_PASSWORD=

# ── Jump host (optional) ───────────────────────────────────────────────────────
# Fill in if the login node is only reachable through a gateway (the same as
# `ssh -J gateway_user@gateway login_node`). The same key is used for both hops.
HPC_JUMP_HOST=
HPC_JUMP_USER=
HPC_JUMP_PORT=22

# ── Host key verification ──────────────────────────────────────────────────────
# The server's host key must already be in this file — connect once with plain `ssh`
# (for a jump host, connect to both). Set HPC_VERIFY_HOST_KEY=false to skip verification
# (not recommended).
HPC_KNOWN_HOSTS=~/.ssh/known_hosts
HPC_VERIFY_HOST_KEY=true

# ── Cluster profile ────────────────────────────────────────────────────────────
# Path to cluster.toml (relative to the repo root). Docs are read from docs/ next to it.
HPC_CLUSTER_CONFIG=cluster/cluster.toml

# ── Project shortcuts (optional) ───────────────────────────────────────────────
# Comma-separated alias:path pairs. Relative paths are resolved against the first
# writable path in cluster.toml. Example: rnaseq:projects/rnaseq,ref:/shared/ref/hg38
HPC_PROJECTS=
HPC_DEFAULT_PROJECT=

# Timeout in seconds for a single remote command.
HPC_COMMAND_TIMEOUT=30
